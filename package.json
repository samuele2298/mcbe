{
  "name": "chess-mentor",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @cm/api db:migrate",
    "seed:openings": "pnpm --filter @cm/api seed:openings",
    "seed:puzzles": "pnpm --filter @cm/api seed:puzzles",
    "kb:ingest": "pnpm --filter @cm/api kb:ingest",
    "kb:index": "pnpm --filter @cm/api kb:index"
  }
}
