# Postgres (container dedicato)
POSTGRES_USER=chessmentor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chessmentor
# porta esposta solo su localhost (5432 è spesso già occupata)
POSTGRES_HOST_PORT=5433

# API
DATABASE_URL=postgres://chessmentor:change-me@localhost:5433/chessmentor
API_PORT=3000
JWT_SECRET=change-me-with-at-least-32-random-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# email che alla registrazione riceve il ruolo admin
ADMIN_EMAILS=
CORS_ORIGINS=http://localhost:8080
# servizio Stockfish (in Docker: http://engine:4000)
ENGINE_URL=http://localhost:4000

# Claude: coach (Fase 5) e tagging della knowledge base (Fase 4). Senza chiave il coach
# mostra solo i fatti verificati e il tagging usa le parole chiave.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_COACH=claude-opus-5-5
CLAUDE_COACH_EFFORT=medium
CLAUDE_MODEL_CHEAP=claude-haiku-4-5

# Embedding della knowledge base (Voyage AI). Senza chiave: ricerca full-text di Postgres.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# Lichess (facoltativo): token personale per opening explorer e import partite
LICHESS_TOKEN=
