# /etc/nginx/sites-available/chess-mentor — reverse proxy verso il compose (API su 127.0.0.1:3000)
server {
    listen 80;
    server_name chess.example.com;   # TODO dominio

    # Flutter web (build statica, dalla Fase 1)
    root /var/www/chess-mentor;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
# HTTPS: certbot --nginx -d chess.example.com
